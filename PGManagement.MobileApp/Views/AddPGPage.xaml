<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PGManagement.MobileApp.ViewModels"
             x:Class="PGManagement.MobileApp.Views.AddPGPage"
             x:DataType="vm:AddPGViewModel"
             Title="Register Estate"
             BackgroundColor="#F8F9FA">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <!--<VerticalStackLayout Spacing="2" Margin="4,4,0,4">
                <Label Text="Estate Management" FontSize="12" FontAttributes="Bold" TextColor="#512BD4" CharacterSpacing="1" />
                <Label Text="New Property Registry" FontSize="24" FontAttributes="Bold" TextColor="#1A1A1A" />
            </VerticalStackLayout>-->

            <!-- Primary Structural Deck -->
            <Border Padding="18" StrokeShape="RoundRectangle 16" StrokeThickness="0" BackgroundColor="White">
                <Border.Shadow>
                    <Shadow Offset="0,4" Radius="12" Brush="#0A000000" Opacity="0.5"/>
                </Border.Shadow>

                <VerticalStackLayout Spacing="16">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Property Nomenclature" FontSize="11" FontAttributes="Bold" TextColor="#6C757D" />
                        <Border Padding="12,2" StrokeShape="RoundRectangle 10" StrokeThickness="1" Stroke="#E2E8F0" BackgroundColor="#F8F9FA">
                            <Entry Placeholder="e.g. Bunny Luxury Living" Text="{Binding Name}" PlaceholderColor="#A0AEC0" HeightRequest="44"/>
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="4">
                        <Label Text="Street Address Location" FontSize="11" FontAttributes="Bold" TextColor="#6C757D" />
                        <Border Padding="12,2" StrokeShape="RoundRectangle 10" StrokeThickness="1" Stroke="#E2E8F0" BackgroundColor="#F8F9FA">
                            <Entry Placeholder="Full street location details" Text="{Binding Address}" PlaceholderColor="#A0AEC0" HeightRequest="44"/>
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="4">
                        <Label Text="Metropolitan City" FontSize="11" FontAttributes="Bold" TextColor="#6C757D" />
                        <Border Padding="12,2" StrokeShape="RoundRectangle 10" StrokeThickness="1" Stroke="#E2E8F0" BackgroundColor="#F8F9FA">
                            <Entry Placeholder="e.g. Mumbai" Text="{Binding City}" PlaceholderColor="#A0AEC0" HeightRequest="44"/>
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="4">
                        <Label Text="Property Profile Description" FontSize="11" FontAttributes="Bold" TextColor="#6C757D" />
                        <Border Padding="12,4" StrokeShape="RoundRectangle 10" StrokeThickness="1" Stroke="#E2E8F0" BackgroundColor="#F8F9FA">
                            <Editor Placeholder="Amenities, landmark, rules..." Text="{Binding Description}" PlaceholderColor="#A0AEC0" HeightRequest="90" AutoSize="Disabled"/>
                        </Border>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- Geolocation Deck Component -->
            <Border Padding="18" StrokeShape="RoundRectangle 16" StrokeThickness="0" BackgroundColor="White">
                <Border.Shadow>
                    <Shadow Offset="0,4" Radius="12" Brush="#0A000000" Opacity="0.5"/>
                </Border.Shadow>

                <VerticalStackLayout Spacing="14">
                    <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                        <Label Grid.Column="0" Text="Geographic Coordinates" FontAttributes="Bold" FontSize="14" TextColor="#4A154B" VerticalOptions="Center"/>
                        <Button Grid.Column="1" Text="Fetch GPS Position" Command="{Binding UseCurrentLocationCommand}" BackgroundColor="#4A154B" TextColor="White" HeightRequest="36" Padding="14,0" CornerRadius="8" FontSize="11" FontAttributes="Bold"/>
                    </Grid>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <VerticalStackLayout Grid.Column="0" Spacing="4">
                            <Label Text="Latitude Coordinate" FontSize="11" FontAttributes="Bold" TextColor="#8D96A0" />
                            <Border Padding="12,2" StrokeShape="RoundRectangle 10" StrokeThickness="1" Stroke="#E2E8F0" BackgroundColor="#F8F9FA">
                                <Entry Placeholder="0.0000" Text="{Binding Latitude}" Keyboard="Numeric" HeightRequest="44"/>
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="1" Spacing="4">
                            <Label Text="Longitude Coordinate" FontSize="11" FontAttributes="Bold" TextColor="#8D96A0" />
                            <Border Padding="12,2" StrokeShape="RoundRectangle 10" StrokeThickness="1" Stroke="#E2E8F0" BackgroundColor="#F8F9FA">
                                <Entry Placeholder="0.0000" Text="{Binding Longitude}" Keyboard="Numeric" HeightRequest="44"/>
                            </Border>
                        </VerticalStackLayout>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Label Text="{Binding ErrorMessage}" TextColor="#E74C3C" FontSize="13" HorizontalTextAlignment="Center" FontAttributes="Italic"
                   IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyConverter}}" />

            <VerticalStackLayout Spacing="10" Margin="0,4,0,14">
                <Button Text="Commit New Property Registry" Command="{Binding SaveCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
                        BackgroundColor="#4A154B" TextColor="White" HeightRequest="52" CornerRadius="12" FontAttributes="Bold" FontSize="16" />
                <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="#512BD4" HorizontalOptions="Center" />
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>