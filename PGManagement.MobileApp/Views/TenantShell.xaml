<?xml version="1.0" encoding="utf-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:views="clr-namespace:PGManagement.MobileApp.Views"
       x:Class="PGManagement.MobileApp.Views.TenantShell"
       FlyoutBehavior="Disabled">

    <TabBar>
        <ShellContent Title="Search PGs" Icon="search.png"
                      ContentTemplate="{DataTemplate views:PGSearchPage}" Route="PGSearchPage" />
        <ShellContent Title="My Bookings" Icon="booking.png"
                      ContentTemplate="{DataTemplate views:HomePage}" Route="MyBookingsPage" />
        <ShellContent Title="Profile" Icon="profile.png"
                      ContentTemplate="{DataTemplate views:HomePage}" Route="ProfilePage" />
    </TabBar>

</Shell>