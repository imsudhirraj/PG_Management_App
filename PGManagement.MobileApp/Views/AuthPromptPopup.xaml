<?xml version="1.0" encoding="utf-8" ?>
<mct:Popup 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:mct="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    x:Class="PGManagement.MobileApp.Views.AuthPromptPopup"
    Color="Transparent">

    <Border 
        WidthRequest="320" 
        Padding="24" 
        BackgroundColor="White" 
        StrokeThickness="0"
        HorizontalOptions="Center" 
        VerticalOptions="Center">
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="20"/>
        </Border.StrokeShape>
        <Border.Shadow>
            <Shadow Brush="#40000000" Offset="0,8" Radius="20"/>
        </Border.Shadow>

        <VerticalStackLayout Spacing="16" HorizontalOptions="Fill">
            <!-- Icon Lock / Branding Element -->
            <Label 
                Text="🔒" 
                FontSize="36" 
                HorizontalOptions="Center" />

            <!-- Polite Header Message -->
            <Label 
                Text="Unlock Premium Features" 
                FontSize="20" 
                FontAttributes="Bold" 
                TextColor="#212121" 
                HorizontalOptions="Center" 
                HorizontalTextAlignment="Center"/>

            <!-- Polite Context Body Text -->
            <Label 
                Text="Please log in or create a quick account to seamlessly view details, book spaces, and manage your custom wishlist." 
                FontSize="14" 
                TextColor="#666666" 
                HorizontalOptions="Center" 
                HorizontalTextAlignment="Center"
                LineHeight="1.2"/>

            <!-- Action Buttons Stack -->
            <VerticalStackLayout Spacing="10" Margin="0,10,0,0">
                <!-- Log In Button (Theme Filled) -->
                <Button 
                    Text="Log In" 
                    Clicked="OnLoginClicked"
                    BackgroundColor="#4A154B" 
                    TextColor="White" 
                    FontAttributes="Bold"
                    HeightRequest="46"
                    CornerRadius="12"/>

                <!-- Register Button (Theme Outlined) -->
                <Button 
                    Text="Create Account" 
                    Clicked="OnRegisterClicked"
                    BackgroundColor="Transparent" 
                    TextColor="#4A154B" 
                    BorderColor="#4A154B"
                    BorderWidth="1"
                    FontAttributes="Bold"
                    HeightRequest="46"
                    CornerRadius="12"/>

                <!-- Dismiss Button -->
                <Button 
                    Text="Maybe Later" 
                    Clicked="OnCancelClicked"
                    BackgroundColor="Transparent" 
                    TextColor="#999999" 
                    FontSize="13"
                    HeightRequest="36"
                    CornerRadius="12"/>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </Border>
</mct:Popup>