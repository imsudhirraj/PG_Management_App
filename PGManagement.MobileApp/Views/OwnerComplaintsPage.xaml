<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PGManagement.MobileApp.ViewModels"
             xmlns:models="clr-namespace:PGManagement.MobileApp.Models"
             x:Class="PGManagement.MobileApp.Views.OwnerComplaintsPage"
             x:DataType="vm:OwnerComplaintsViewModel"
             Title="Ticket Dispatch"
             BackgroundColor="#F8F9FA">

    <RefreshView Command="{Binding LoadCommand}" IsRefreshing="{Binding IsBusy}" RefreshColor="#512BD4">
        <Grid Padding="20">
            <Label Text="{Binding StatusMessage}" IsVisible="{Binding StatusMessage, Converter={StaticResource StringNotEmptyConverter}}"
                   HorizontalOptions="Center" VerticalOptions="Start" Margin="0,20,0,0" TextColor="#A0AEC0" FontAttributes="Italic" />

            <CollectionView ItemsSource="{Binding Complaints}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:ComplaintOverviewResponse">
                        <Border Margin="0,0,0,14" Padding="16" StrokeShape="RoundRectangle 16" StrokeThickness="0" BackgroundColor="White">
                            <Border.Shadow>
                                <Shadow Offset="0,3" Radius="8" Brush="#0A000000" Opacity="0.4"/>
                            </Border.Shadow>

                            <VerticalStackLayout Spacing="12">
                                <Grid ColumnDefinitions="*,Auto">
                                    <VerticalStackLayout Grid.Column="0" Spacing="4">
                                        <Label Text="{Binding Title}" FontAttributes="Bold" FontSize="17" TextColor="#1A1A1A" />
                                        <Label Text="{Binding TenantName, StringFormat='Reported by: {0}'}" FontSize="12" TextColor="#718096" />
                                    </VerticalStackLayout>

                                    <Border Grid.Column="1" Padding="10,4" StrokeShape="RoundRectangle 12" StrokeThickness="0" BackgroundColor="#F8F9FA" VerticalOptions="Start">
                                        <Label Text="{Binding Status}" FontAttributes="Bold" FontSize="10" CharacterSpacing="0.5"
                                               TextColor="{Binding Status, Converter={StaticResource StatusColorConverter}}" />
                                    </Border>
                                </Grid>

                                <Border BackgroundColor="#FFF5F5" StrokeShape="RoundRectangle 8" StrokeThickness="0" Padding="12">
                                    <Label Text="{Binding Description}" FontSize="13" TextColor="#C53030" LineHeight="1.2"/>
                                </Border>

                                <Grid ColumnDefinitions="*,Auto" Margin="2,0">
                                    <Label Grid.Column="0" Text="{Binding RaisedAt, StringFormat='Logged: {0:dd MMM yyyy}'}" TextColor="#A0AEC0" FontSize="11" VerticalOptions="Center"/>
                                    <Button Grid.Column="1" Text="Execute Resolution" Command="{Binding Source={RelativeSource AncestorType={x:Type vm:OwnerComplaintsViewModel}}, Path=MarkResolvedCommand}" CommandParameter="{Binding .}"
                                            IsVisible="{Binding Status, Converter={StaticResource StringNotEmptyConverter}}"
                                            BackgroundColor="#2ECC71" TextColor="White" HeightRequest="34" Padding="14,0" CornerRadius="6" FontAttributes="Bold" FontSize="12" />
                                </Grid>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>
    </RefreshView>
</ContentPage>