<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PGManagement.MobileApp.ViewModels"
             x:Class="PGManagement.MobileApp.Views.TenantDetailPage"
             x:DataType="vm:TenantDetailViewModel"
             Title="Resident Dossier"
             BackgroundColor="#F8F9FA">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="⚙️ Modify" Command="{Binding ToggleEditCommand}" />
    </ContentPage.ToolbarItems>

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="#512BD4" HorizontalOptions="Center"/>

            <Border IsVisible="{Binding IsEditing, Converter={StaticResource InvertedBoolConverter}}" Padding="20" StrokeShape="RoundRectangle 16" StrokeThickness="0" BackgroundColor="White">
                <Border.Shadow>
                    <Shadow Offset="0,4" Radius="12" Brush="#0A000000" Opacity="0.5"/>
                </Border.Shadow>

                <VerticalStackLayout Spacing="12">
                    <Label Text="{Binding FullName}" FontSize="24" FontAttributes="Bold" TextColor="#4A154B" />

                    <HorizontalStackLayout Spacing="6" Margin="0,0,0,4">
                        <Border BackgroundColor="#EBF4FF" Padding="8,4" StrokeShape="RoundRectangle 6" StrokeThickness="0">
                            <Label Text="{Binding Phone}" FontSize="12" FontAttributes="Bold" TextColor="#2B6CB0" />
                        </Border>
                    </HorizontalStackLayout>

                    <BoxView HeightRequest="1" Color="#EDF2F7" />

                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto" Margin="0,4">
                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                            <Label Text="ASSIGNED ESTATE" FontSize="10" FontAttributes="Bold" TextColor="#A0AEC0" CharacterSpacing="0.5"/>
                            <Label Text="{Binding PgName}" FontSize="14" FontAttributes="Bold" TextColor="#2D3748"/>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                            <Label Text="LOCATION SPACE" FontSize="10" FontAttributes="Bold" TextColor="#A0AEC0" CharacterSpacing="0.5"/>
                            <Label Text="{Binding RoomNumber, StringFormat='Room {0}'}" FontSize="14" FontAttributes="Bold" TextColor="#4A154B"/>
                        </VerticalStackLayout>
                    </Grid>

                    <Label Text="{Binding CheckInDate, StringFormat='System Admission: {0:dd MMM yyyy}'}" FontSize="12" TextColor="#718096" FontAttributes="Italic" />
                    <BoxView HeightRequest="1" Color="#EDF2F7" />

                    <VerticalStackLayout Spacing="4" BackgroundColor="#F7FAFC" Padding="12" Margin="0,4,0,0">
                        <Label Text="EMERGENCY CONTACT PROTOCOL" FontSize="10" FontAttributes="Bold" TextColor="#718096" CharacterSpacing="0.5"/>
                        <Label Text="{Binding EmergencyContactName}" FontSize="14" FontAttributes="Bold" TextColor="#2D3748"/>
                        <Label Text="{Binding EmergencyContactPhone}" FontSize="13" TextColor="#4A5568"/>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <Border IsVisible="{Binding IsEditing}" Padding="18" StrokeShape="RoundRectangle 16" StrokeThickness="0" BackgroundColor="White">
                <Border.Shadow>
                    <Shadow Offset="0,4" Radius="12" Brush="#0A000000" Opacity="0.5"/>
                </Border.Shadow>
                <VerticalStackLayout Spacing="14">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Full Legal Name" FontSize="11" FontAttributes="Bold" TextColor="#6C757D" />
                        <Border Padding="12,2" StrokeShape="RoundRectangle 10" StrokeThickness="1" Stroke="#E2E8F0" BackgroundColor="#F8F9FA">
                            <Entry Text="{Binding FullName}" HeightRequest="44"/>
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="4">
                        <Label Text="Primary Phone Communications" FontSize="11" FontAttributes="Bold" TextColor="#6C757D" />
                        <Border Padding="12,2" StrokeShape="RoundRectangle 10" StrokeThickness="1" Stroke="#E2E8F0" BackgroundColor="#F8F9FA">
                            <Entry Text="{Binding Phone}" Keyboard="Telephone" HeightRequest="44"/>
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="4">
                        <Label Text="Emergency Contact Identity" FontSize="11" FontAttributes="Bold" TextColor="#6C757D" />
                        <Border Padding="12,2" StrokeShape="RoundRectangle 10" StrokeThickness="1" Stroke="#E2E8F0" BackgroundColor="#F8F9FA">
                            <Entry Text="{Binding EmergencyContactName}" HeightRequest="44"/>
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="4">
                        <Label Text="Emergency Communication Line" FontSize="11" FontAttributes="Bold" TextColor="#6C757D" />
                        <Border Padding="12,2" StrokeShape="RoundRectangle 10" StrokeThickness="1" Stroke="#E2E8F0" BackgroundColor="#F8F9FA">
                            <Entry Text="{Binding EmergencyContactPhone}" Keyboard="Telephone" HeightRequest="44"/>
                        </Border>
                    </VerticalStackLayout>

                    <Button Text="Commit Profile Updates" Command="{Binding SaveCommand}" BackgroundColor="#512BD4" TextColor="White" HeightRequest="46" CornerRadius="10" FontAttributes="Bold" Margin="0,4,0,0"/>
                </VerticalStackLayout>
            </Border>

            <Label Text="{Binding StatusMessage}" TextColor="#E74C3C" FontSize="13" HorizontalTextAlignment="Center" FontAttributes="Italic"
                   IsVisible="{Binding StatusMessage, Converter={StaticResource StringNotEmptyConverter}}" />

            <Button Text="Offboard Resident (Checkout)" Command="{Binding CheckoutCommand}" BackgroundColor="#E74C3C" TextColor="White" HeightRequest="50" CornerRadius="12" FontAttributes="Bold" Margin="0,10,0,10" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>