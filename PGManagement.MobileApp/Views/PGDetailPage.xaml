<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PGManagement.MobileApp.ViewModels"
             x:Class="PGManagement.MobileApp.Views.PGDetailPage"
             x:DataType="vm:PGDetailViewModel"
             ControlTemplate="{StaticResource GlobalJourneyTemplate}"
             Title="Estate Profile"
             BackgroundColor="#F8F9FA">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="⚙️ Modify" Command="{Binding ToggleEditCommand}" />
    </ContentPage.ToolbarItems>

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="#512BD4" HorizontalOptions="Center"/>

            <!-- Pure Read-Only View Deck -->
            <Border IsVisible="{Binding IsEditing, Converter={StaticResource InvertedBoolConverter}}" Padding="20" StrokeShape="RoundRectangle 16" StrokeThickness="0" BackgroundColor="White">
                <Border.Shadow>
                    <Shadow Offset="0,4" Radius="12" Brush="#0A000000" Opacity="0.5"/>
                </Border.Shadow>
                <VerticalStackLayout Spacing="12">
                    <Label Text="{Binding Name}" FontSize="24" FontAttributes="Bold" TextColor="#4A154B" />

                    <HorizontalStackLayout Spacing="6">
                        <Border BackgroundColor="#E2E8F0" Padding="8,4" StrokeShape="RoundRectangle 6" StrokeThickness="0">
                            <Label Text="{Binding City}" FontSize="11" FontAttributes="Bold" TextColor="#4A5568" />
                        </Border>
                        <Label Text="{Binding Address}" FontSize="13" TextColor="#718096" VerticalOptions="Center" />
                    </HorizontalStackLayout>

                    <BoxView HeightRequest="1" Color="#F0F4F8" Margin="0,4" />
                    <Label Text="About Estate Profile" FontSize="12" FontAttributes="Bold" TextColor="#A0AEC0" CharacterSpacing="0.5" />
                    <Label Text="{Binding Description}" FontSize="14" TextColor="#2D3748" LineHeight="1.3" />
                </VerticalStackLayout>
            </Border>

            <!-- Interactive Modify Form Deck -->
            <Border IsVisible="{Binding IsEditing}" Padding="18" StrokeShape="RoundRectangle 16" StrokeThickness="0" BackgroundColor="White">
                <Border.Shadow>
                    <Shadow Offset="0,4" Radius="12" Brush="#0A000000" Opacity="0.5"/>
                </Border.Shadow>
                <VerticalStackLayout Spacing="14">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Estate Name" FontSize="11" FontAttributes="Bold" TextColor="#4a154b" />
                        <Border Padding="12,2" StrokeShape="RoundRectangle 10" StrokeThickness="1" Stroke="#E2E8F0" BackgroundColor="#F8F9FA">
                            <Entry Text="{Binding Name}" HeightRequest="44"/>
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="4">
                        <Label Text="Property Location Address" FontSize="11" FontAttributes="Bold" TextColor="#4a154b" />
                        <Border Padding="12,2" StrokeShape="RoundRectangle 10" StrokeThickness="1" Stroke="#E2E8F0" BackgroundColor="#F8F9FA">
                            <Entry Text="{Binding Address}" HeightRequest="44"/>
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="4">
                        <Label Text="City Location" FontSize="11" FontAttributes="Bold" TextColor="#4a154b" />
                        <Border Padding="12,2" StrokeShape="RoundRectangle 10" StrokeThickness="1" Stroke="#E2E8F0" BackgroundColor="#F8F9FA">
                            <Entry Text="{Binding City}" HeightRequest="44"/>
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="4">
                        <Label Text="Profile Description Statement" FontSize="11" FontAttributes="Bold" TextColor="#4a154b" />
                        <Border Padding="12,4" StrokeShape="RoundRectangle 10" StrokeThickness="1" Stroke="#E2E8F0" BackgroundColor="#F8F9FA">
                            <Editor Text="{Binding Description}" HeightRequest="90"/>
                        </Border>
                    </VerticalStackLayout>

                    <Button Text="Commit Profile Upgrades" Command="{Binding SaveCommand}" BackgroundColor="#4a154b" TextColor="White" HeightRequest="46" CornerRadius="10" FontAttributes="Bold" Margin="0,4,0,0"/>
                </VerticalStackLayout>
            </Border>

            <Label Text="{Binding StatusMessage}" TextColor="#E74C3C" FontSize="13" HorizontalTextAlignment="Center" FontAttributes="Italic"
                   IsVisible="{Binding StatusMessage, Converter={StaticResource StringNotEmptyConverter}}" />

            <!-- Destructive Action Segment Grid -->
            <Button Text="Deprovision Estate Profile" Command="{Binding DeleteCommand}" BackgroundColor="#4A154B" TextColor="White" HeightRequest="50" CornerRadius="12" FontAttributes="Bold" Margin="0,10,0,10"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>