<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PGManagement.MobileApp.ViewModels"
             x:Class="PGManagement.MobileApp.Views.PGDetailPage"
             x:DataType="vm:PGDetailViewModel"
             Title="PG Details">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Edit" Command="{Binding ToggleEditCommand}" />
    </ContentPage.ToolbarItems>

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="14">

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />

            <!-- Read-only view -->
            <VerticalStackLayout IsVisible="{Binding IsEditing, Converter={StaticResource InvertedBoolConverter}}" Spacing="10">
                <Label Text="{Binding Name}" FontSize="24" FontAttributes="Bold" />
                <Label Text="{Binding Address}" FontSize="14" TextColor="Gray" />
                <Label Text="{Binding City}" FontSize="14" TextColor="Gray" />
                <Label Text="{Binding Description}" FontSize="14" Margin="0,10,0,0" />
            </VerticalStackLayout>

            <!-- Edit form -->
            <VerticalStackLayout IsVisible="{Binding IsEditing}" Spacing="10">
                <Entry Placeholder="Name" Text="{Binding Name}" />
                <Entry Placeholder="Address" Text="{Binding Address}" />
                <Entry Placeholder="City" Text="{Binding City}" />
                <Editor Placeholder="Description" Text="{Binding Description}" HeightRequest="80" />
                <Button Text="Save Changes" Command="{Binding SaveCommand}" />
            </VerticalStackLayout>

            <Label Text="{Binding StatusMessage}" TextColor="Red"
                   IsVisible="{Binding StatusMessage, Converter={StaticResource StringNotEmptyConverter}}" />

            <BoxView HeightRequest="1" Color="LightGray" Margin="0,20,0,10" />

            <Button Text="Delete PG" Command="{Binding DeleteCommand}" BackgroundColor="IndianRed" TextColor="White" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>