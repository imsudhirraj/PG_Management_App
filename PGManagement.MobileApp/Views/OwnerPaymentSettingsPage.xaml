<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:PGManagement.MobileApp.ViewModels"
    x:Class="PGManagement.MobileApp.Views.OwnerPaymentSettingsPage"
    x:DataType="vm:OwnerPaymentSettingsViewModel"
    Title="Payment Settings">

    <ScrollView>

        <VerticalStackLayout
            Padding="20"
            Spacing="20">

            <Label
                Text="Owner Payment Settings"
                FontSize="24"
                FontAttributes="Bold"/>

            <Entry
                Placeholder="Account Holder Name"
                Text="{Binding AccountHolderName}" />

            <Entry
                Placeholder="UPI ID"
                Text="{Binding UpiId}" />

            <Button
                Text="Save"
                Command="{Binding SaveCommand}"
                BackgroundColor="#512BD4"
                TextColor="White"/>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>