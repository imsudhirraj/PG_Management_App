<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:PGManagement.MobileApp.ViewModels"
    xmlns:models="clr-namespace:PGManagement.MobileApp.Models"
    x:Class="PGManagement.MobileApp.Views.MyBookingsPage"
    x:DataType="vm:MyBookingsViewModel"
    ControlTemplate="{StaticResource GlobalJourneyTemplate}"
    Title="My Reservations"
    BackgroundColor="{AppThemeBinding Light=#F8F9FA, Dark=#121212}">

    <RefreshView
        Command="{Binding LoadBookingsCommand}"
        IsRefreshing="{Binding IsBusy}"
        RefreshColor="#4A154B">

        <Grid Padding="16,10,16,80" RowDefinitions="*" >

            <Label Text="{Binding StatusMessage}"
                   IsVisible="{Binding StatusMessage, Converter={StaticResource StringNotEmptyConverter}}"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"
                   TextColor="{AppThemeBinding Light=#94A3B8, Dark=#64748B}"
                   FontSize="14"
                   FontAttributes="Italic"/>

            <CollectionView ItemsSource="{Binding Bookings}">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="12"/>
                </CollectionView.ItemsLayout>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:BookingResponse">

                        <!-- Compact card structure -->
                        <Border Padding="12"
                                StrokeThickness="0"
                                BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12"/>
                            </Border.StrokeShape>
                            <Border.Shadow>
                                <Shadow Offset="0,2" Radius="6" Brush="#000000" Opacity="0.08"/>
                            </Border.Shadow>

                            <VerticalStackLayout Spacing="10">

                                <!-- Top Header Section -->
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                    <VerticalStackLayout Grid.Column="0" Spacing="2">
                                        <Label Text="{Binding PGName}"
                                               FontAttributes="Bold"
                                               FontSize="16"
                                               TextColor="{AppThemeBinding Light=#1E293B, Dark=White}"/>

                                        <!-- Inline address and city to save vertical space -->
                                        <Label HorizontalOptions="Start" FontSize="11" TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="{Binding PGAddress}" />
                                                    <Span Text=" • " TextColor="#4A154B" />
                                                    <Span Text="{Binding City}" FontAttributes="Bold" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>
                                    </VerticalStackLayout>

                                    <!-- Status Pill -->
                                    <Border Grid.Column="1"
                                            Padding="10,4"
                                            StrokeThickness="0"
                                            VerticalOptions="Center"
                                            BackgroundColor="{AppThemeBinding Light=#F1F5F9, Dark=#2D2D2D}">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="8"/>
                                        </Border.StrokeShape>
                                        <Label Text="{Binding Status}"
                                               FontAttributes="Bold"
                                               FontSize="10"
                                               TextColor="{Binding Status, Converter={StaticResource StatusColorConverter}}"/>
                                    </Border>
                                </Grid>

                                <!-- Mid Info Row: Room and Date side by side to reduce height -->
                                <!-- Mid Info Row: Room and Date side by side to reduce height -->
                                <Border BackgroundColor="{AppThemeBinding Light=#F5EEF6, Dark=#2A1C2B}" 
        Padding="10,8" 
        StrokeThickness="0">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="8"/>
                                    </Border.StrokeShape>

                                    <Grid ColumnDefinitions="*, *">
                                        <Label Grid.Column="0" 
               Text="{Binding RoomNumber, StringFormat='Room {0}'}"
               FontAttributes="Bold"
               FontSize="12"
               TextColor="#4A154B"
               VerticalOptions="Center"/>

                                        <Label Grid.Column="1" 
               Text="{Binding BookingDate, StringFormat='{0:dd MMM yyyy}'}"
               FontSize="11"
               TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}"
               HorizontalOptions="End"
               VerticalOptions="Center"/>
                                    </Grid>
                                </Border>

                                <!-- User Message Layer (More compact) -->
                                <VerticalStackLayout Spacing="1">
                                    <Label Text="Note:"
                                           FontSize="10"
                                           FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light=#94A3B8, Dark=#64748B}"/>
                                    <Label Text="{Binding Message}"
                                           FontSize="12"
                                           TextColor="{AppThemeBinding Light=#4A5568, Dark=#CBD5E1}"/>
                                </VerticalStackLayout>

                                <!-- Minimal Action Row (Replaces the large green box & huge stacked buttons) -->
                                <VerticalStackLayout Spacing="8" IsVisible="{Binding CanUploadKyc}">

                                    <!-- Simple thin boundary separator -->
                                    <BoxView HeightRequest="1" BackgroundColor="{AppThemeBinding Light=#E2E8F0, Dark=#333333}" Margin="0,2" />

                                    <Grid ColumnDefinitions="*, *, *" ColumnSpacing="8">
                                        <!-- Sleek compact action buttons with 36px max heights -->
                                        <Button Grid.Column="0"
                                                Text="KYC"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.UploadKycCommand}"
                                                CommandParameter="{Binding .}"
                                                BackgroundColor="#4A154B"
                                                TextColor="White"
                                                FontSize="11"
                                                HeightRequest="36"
                                                Padding="0"
                                                CornerRadius="6"/>

                                        <Button Grid.Column="1"
                                                Text="Pay"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.PayAdvanceCommand}"
                                                CommandParameter="{Binding .}"
                                                IsVisible="{Binding CanPay}"
                                                BackgroundColor="{AppThemeBinding Light=#334155, Dark=#475569}"
                                                TextColor="White"
                                                FontSize="11"
                                                HeightRequest="36"
                                                Padding="0"
                                                CornerRadius="6"/>

                                        <Button Grid.Column="2"
                                                Text="Chat"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.ChatWithOwnerCommand}"
                                                CommandParameter="{Binding .}"
                                                IsVisible="{Binding CanChat}"
                                                BackgroundColor="{AppThemeBinding Light=#F1F5F9, Dark=#2D2D2D}"
                                                TextColor="{AppThemeBinding Light=#1E293B, Dark=White}"
                                                FontSize="11"
                                                HeightRequest="36"
                                                Padding="0"
                                                CornerRadius="6"/>
                                    </Grid>
                                </VerticalStackLayout>

                            </VerticalStackLayout>
                        </Border>

                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </Grid>
    </RefreshView>
</ContentPage>