<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PGManagement.MobileApp.ViewModels"
             xmlns:models="clr-namespace:PGManagement.MobileApp.Models"
             x:Class="PGManagement.MobileApp.Views.PGSearchPage"
             x:DataType="vm:PGSearchViewModel"
             Title="Discover Housing"
             BackgroundColor="#F8F9FA">

    <Grid RowDefinitions="Auto,*" Padding="16" RowSpacing="16">

        <!-- Search Geometry Parameter Deck -->
        <Border Grid.Row="0" Padding="18" StrokeShape="RoundRectangle 16" StrokeThickness="0" BackgroundColor="White">
            <Border.Shadow>
                <Shadow Offset="0,4" Radius="12" Brush="#0A000000" Opacity="0.5"/>
            </Border.Shadow>
            <VerticalStackLayout Spacing="12">
                <Grid ColumnDefinitions="*,Auto">
                    <Label Grid.Column="0" Text="Geofence Scanning Radius" FontAttributes="Bold" FontSize="12" TextColor="#6C757D" CharacterSpacing="0.5"/>
                    <HorizontalStackLayout Grid.Column="1" Spacing="2">
                        <Label Text="{Binding RadiusKm, StringFormat='{0:F0}'}" FontAttributes="Bold" TextColor="#512BD4" FontSize="14"/>
                        <Label Text=" km" TextColor="#718096" FontSize="12" VerticalOptions="End" Margin="0,0,0,1"/>
                    </HorizontalStackLayout>
                </Grid>

                <Slider Minimum="1" Maximum="20" Value="{Binding RadiusKm}" ThumbColor="#512BD4" MinimumTrackColor="#512BD4" MaximumTrackColor="#E2E8F0" />

                <Button Text="Scan Nearby Accommodations" Command="{Binding SearchNearbyCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
                        BackgroundColor="#512BD4" TextColor="White" HeightRequest="46" CornerRadius="10" FontAttributes="Bold" FontSize="14"/>
            </VerticalStackLayout>
        </Border>

        <!-- Dynamic Registry Stream Module -->
        <Grid Grid.Row="1">
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="#4A154B" VerticalOptions="Center" HorizontalOptions="Center" />

            <Label Text="{Binding StatusMessage}" IsVisible="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
                   HorizontalOptions="Center" VerticalOptions="Start" Margin="0,10,0,0" TextColor="#A0AEC0" FontAttributes="Italic" />

            <CollectionView ItemsSource="{Binding Results}" Margin="0,30,0,0">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:PGSearchResult">
                        <Border Margin="0,0,0,12" Padding="16" StrokeShape="RoundRectangle 16" StrokeThickness="0" BackgroundColor="White">
                            <Border.Shadow>
                                <Shadow Offset="0,2" Radius="6" Brush="#0A000000" Opacity="0.4"/>
                            </Border.Shadow>

                            <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                                <VerticalStackLayout Grid.Column="0" Spacing="6">
                                    <Label Text="{Binding Name}" FontAttributes="Bold" FontSize="17" TextColor="#1A1A1A" />
                                    <Label Text="{Binding Address}" FontSize="13" TextColor="#718096" />

                                    <HorizontalStackLayout Spacing="8" Margin="0,2,0,0">
                                        <Border BackgroundColor="#F7FAFC" Padding="8,4" StrokeShape="RoundRectangle 6" StrokeThickness="1" Stroke="#E2E8F0">
                                            <Label Text="{Binding DistanceKm, StringFormat='📍 {0:F1} km away'}" FontSize="11" FontAttributes="Bold" TextColor="#4A5568" />
                                        </Border>
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>

                                <!-- Micro Inventory Monitoring Label Badge -->
                                <Border Grid.Column="1" BackgroundColor="#E8F8F5" Padding="12,8" StrokeShape="RoundRectangle 10" StrokeThickness="0" VerticalOptions="Center">
                                    <VerticalStackLayout HorizontalOptions="Center">
                                        <Label Text="{Binding AvailableBeds}" FontSize="16" FontAttributes="Bold" TextColor="#1ABC9C" HorizontalOptions="Center" />
                                        <Label Text="VACANT" FontSize="9" FontAttributes="Bold" TextColor="#1ABC9C" CharacterSpacing="0.5" HorizontalOptions="Center" />
                                    </VerticalStackLayout>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>
    </Grid>
</ContentPage>