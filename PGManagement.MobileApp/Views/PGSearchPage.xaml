<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:viewModels="clr-namespace:PGManagement.MobileApp.ViewModels;assembly=PGManagement.MobileApp"
    xmlns:models="clr-namespace:PGManagement.MobileApp.Models;assembly=PGManagement.MobileApp"
    x:Class="PGManagement.MobileApp.Views.PGSearchPage"
    x:DataType="viewModels:PGSearchViewModel"
    ControlTemplate="{StaticResource GlobalJourneyTemplate}"
    BackgroundColor="#F8F9FA"
    Shell.NavBarIsVisible="False">

    <ContentPage.Behaviors>
        <toolkit:StatusBarBehavior StatusBarColor="#2D0B30" StatusBarStyle="LightContent" />
    </ContentPage.Behaviors>

    <Grid>
        <RefreshView
            IsRefreshing="{Binding IsRefreshing}"
            Command="{Binding RefreshCommand}"
            RefreshColor="#4A154B">

            <ScrollView x:Name="MainScrollView">
                <VerticalStackLayout Spacing="0" BackgroundColor="#F5EEF6" Padding="0,0,0,24">

                    <Grid HeightRequest="390">
                        <Grid.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <LinearGradientBrush.GradientStops>
                                    <GradientStop Offset="0.0" Color="#2D0B30" />
                                    <GradientStop Offset="0.6" Color="#4A154B" />
                                    <GradientStop Offset="1.0" Color="#631D64" />
                                </LinearGradientBrush.GradientStops>
                            </LinearGradientBrush>
                        </Grid.Background>

                        <VerticalStackLayout Padding="24,40,24,25" Spacing="16">
                            <Grid ColumnDefinitions="*, Auto">
                                <HorizontalStackLayout Grid.Column="0" Spacing="14">
                                    <Border WidthRequest="48" HeightRequest="48" BackgroundColor="#F5EEF6" StrokeThickness="0">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="12"/>
                                        </Border.StrokeShape>
                                        <Image Source="bunny_logo.png" Margin="8"/>
                                    </Border>
                                    <VerticalStackLayout VerticalOptions="Center" Spacing="2">
                                        <Label Text="BUNNY PG" FontSize="22" FontAttributes="Bold" TextColor="White" CharacterSpacing="1"/>
                                        <Label Text="Premium Co-Living" FontSize="11" TextColor="#E2CCD3" FontAttributes="None"/>
                                    </VerticalStackLayout>
                                </HorizontalStackLayout>

                                <Button Grid.Column="1" 
                                        Text="Login" 
                                        TextColor="White"
                                        FontSize="14"
                                        FontAttributes="Bold"
                                        BackgroundColor="#20FFFFFF"
                                        BorderColor="#40FFFFFF"
                                        BorderWidth="1"
                                        HeightRequest="36"
                                        Padding="14,0"
                                        CornerRadius="8"
                                        VerticalOptions="Center"
                                        Command="{Binding GoToLoginCommand}"/>
                            </Grid>

                            <Label Text="Find your perfect accommodation" FontSize="26" FontAttributes="Bold" TextColor="White" LineBreakMode="WordWrap"/>
                            <Label Text="Verified PGs • Affordable Rent • Instant Booking" FontSize="13" TextColor="#F3E8EE"/>

                            <HorizontalStackLayout Spacing="10">
                                <Border Padding="12,6" BackgroundColor="#20FFFFFF" StrokeThickness="0">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="20"/>
                                    </Border.StrokeShape>
                                    <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                        <Path Data="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" Stroke="White" StrokeThickness="1.5" HeightRequest="12" WidthRequest="12" VerticalOptions="Center"/>
                                        <Label Text="50+ PGs" FontAttributes="Bold" FontSize="11" TextColor="White" VerticalOptions="Center"/>
                                    </HorizontalStackLayout>
                                </Border>
                                <Border Padding="12,6" BackgroundColor="#20FFFFFF" StrokeThickness="0">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="20"/>
                                    </Border.StrokeShape>
                                    <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                        <Path Data="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" Fill="#EAB308" HeightRequest="12" WidthRequest="12" VerticalOptions="Center"/>
                                        <Label Text="4.8 Rating" FontAttributes="Bold" FontSize="11" TextColor="White" VerticalOptions="Center"/>
                                    </HorizontalStackLayout>
                                </Border>
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Grid>

                    <Border
                        Margin="20,-65,20,0"
                        Padding="20"
                        BackgroundColor="#F5EEF6"
                        StrokeThickness="0"
                        ZIndex="10">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="20"/>
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="#1A000000" Offset="0,10" Radius="20"/>
                        </Border.Shadow>

                        <VerticalStackLayout Spacing="16">
                            <Label Text="Search Nearby PGs" FontSize="18" FontAttributes="Bold" TextColor="#1F1F1F"/>
                            <Label Text="{Binding StatusMessage}"
       FontSize="12"
       TextColor="#495057"
       IsVisible="{Binding StatusMessage, Converter={StaticResource StringNotEmptyConverter}}"
       Margin="0,-8,0,0"/>
                            <Border Padding="14,4" BackgroundColor="White" Stroke="#E2CCD3" StrokeThickness="1">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12"/>
                                </Border.StrokeShape>
                                <Grid ColumnDefinitions="Auto,*">
                                    <Path Data="M11 19a8 8 0 1 0 0-16 8 8 0 0 0 0 16z M21 21l-4.35-4.35"
                  Stroke="#4A154B"
                  StrokeThickness="2"
                  StrokeLineCap="Round"
                  StrokeLineJoin="Round"
                  Aspect="Uniform"
                  HeightRequest="18"
                  WidthRequest="18"
                  VerticalOptions="Center"
                  Margin="2,0,0,0"/>
                                    <Entry Grid.Column="1" Margin="10,0,0,0" Placeholder="Where you are planing to stay at.." PlaceholderColor="#A3849E" Text="{Binding SearchText}" BackgroundColor="Transparent" TextColor="#2D0B30" FontSize="14"/>
                                </Grid>
                            </Border>

                            <!-- Row 1: Current Location + Locate button -->
                            <Grid ColumnDefinitions="Auto,*,Auto" VerticalOptions="Center">
                                <Border WidthRequest="36" HeightRequest="36" BackgroundColor="#F5EEF6" StrokeThickness="0" Padding="8">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="8"/>
                                    </Border.StrokeShape>
                                    <Path Data="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z M12 13a3 3 0 1 0 0-6 3 3 0 0 0 0 6z"
                  Stroke="#4A154B"
                  StrokeThickness="2"
                  StrokeLineCap="Round"
                  StrokeLineJoin="Round"
                  Aspect="Uniform"
                  HorizontalOptions="Center"
                  VerticalOptions="Center"/>
                                </Border>

                                <VerticalStackLayout Grid.Column="1" Margin="12,0" VerticalOptions="Center">
                                    <Label Text="Current Location" FontAttributes="Bold" FontSize="13" TextColor="#495057"/>
                                </VerticalStackLayout>
                                <Button Grid.Column="2" Text="Locate" Padding="14,0" HeightRequest="32" CornerRadius="8" BackgroundColor="#4A154B" TextColor="White" FontAttributes="Bold" FontSize="12" Command="{Binding LocateMeCommand}"/>
                            </Grid>

                            <!-- Row 2: Radius slider — sibling of Row 1, NOT nested inside it -->
                            <Grid ColumnDefinitions="Auto,*,Auto"
      VerticalOptions="Center">

                                <Label Text="Radius"
           FontAttributes="Bold"
           FontSize="13"
           TextColor="#495057"
           VerticalOptions="Center" />

                                <Slider Grid.Column="1"
            Margin="10,0"
            Minimum="1"
            Maximum="50"
            Value="{Binding RadiusKm, Mode=TwoWay}"
            MinimumTrackColor="#4A154B"
            MaximumTrackColor="#E2CCD3"
            ThumbColor="#4A154B" />

                                <Label Grid.Column="2"
           Text="{Binding RadiusKm, StringFormat='{0:0} km'}"
           FontAttributes="Bold"
           FontSize="13"
           TextColor="#4A154B"
           VerticalOptions="Center"
           WidthRequest="55"
           HorizontalTextAlignment="End"/>

                            </Grid>

                            <Button x:Name="SearchPropertiesButton" HeightRequest="48" CornerRadius="12" FontAttributes="Bold" FontSize="15" Text="Search PGs" Command="{Binding SearchNearbyCommand}" BackgroundColor="#4A154B" TextColor="White"/>
                        </VerticalStackLayout>
                    </Border>

                    <VerticalStackLayout x:Name="NearbySection" Margin="20,24,20,0" Spacing="14">
                        <VerticalStackLayout.Triggers>
                            <DataTrigger TargetType="VerticalStackLayout" Binding="{Binding NearbyPGs.Count}" Value="0">
                                <Setter Property="IsVisible" Value="False"/>
                            </DataTrigger>
                        </VerticalStackLayout.Triggers>

                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Nearby PGs" FontSize="20" FontAttributes="Bold" TextColor="#1F1F1F"/>
                            <Label Grid.Column="1" Text="{Binding NearbyPGs.Count, StringFormat='{0} Found'}" Padding="8,4" FontSize="13" FontAttributes="Bold" BackgroundColor="#F5EEF6" TextColor="#4A154B" VerticalOptions="Center"/>
                        </Grid>

                        <CollectionView ItemsSource="{Binding NearbyPGs}" HeightRequest="310" SelectionMode="None">
                            <CollectionView.ItemsLayout>
                                <LinearItemsLayout Orientation="Horizontal" ItemSpacing="16"/>
                            </CollectionView.ItemsLayout>
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:PGCardResponse">
                                    <Border WidthRequest="260" Margin="0" BackgroundColor="White" StrokeThickness="1" Stroke="#E9ECEF">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="16"/>
                                        </Border.StrokeShape>
                                        <Border.Shadow>
                                            <Shadow Brush="#0F000000" Offset="0,6" Radius="12"/>
                                        </Border.Shadow>
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewModels:PGSearchViewModel}}, Path=GoToPGDetailCommand}" CommandParameter="{Binding .}"/>
                                        </Border.GestureRecognizers>

                                        <Grid RowDefinitions="150,*">
                                            <Grid Grid.Row="0">
                                                <Border StrokeThickness="0">
                                                    <Border.StrokeShape>
                                                        <RoundRectangle CornerRadius="16,16,0,0"/>
                                                    </Border.StrokeShape>
                                                    <Image Source="{Binding DisplayImage, TargetNullValue='bunny_logo.png', FallbackValue='bunny_logo.png'}" Aspect="AspectFill"/>
                                                </Border>

                                                <HorizontalStackLayout Margin="12" HorizontalOptions="Start" VerticalOptions="Start" Spacing="4">
                                                    <Border BackgroundColor="#22C55E" Padding="6,2" StrokeThickness="0" IsVisible="{Binding ShowVerified}">
                                                        <Border.StrokeShape>
                                                            <RoundRectangle CornerRadius="4"/>
                                                        </Border.StrokeShape>
                                                        <Label Text="Verified" FontSize="9" TextColor="White" FontAttributes="Bold"/>
                                                    </Border>
                                                    <Border BackgroundColor="#0D6EFD" Padding="6,2" StrokeThickness="0">
                                                        <Border.StrokeShape>
                                                            <RoundRectangle CornerRadius="4"/>
                                                        </Border.StrokeShape>
                                                        <Label Text="{Binding DistanceKm, StringFormat='{0:0.0} km'}" FontSize="9" TextColor="White" FontAttributes="Bold"/>
                                                    </Border>
                                                </HorizontalStackLayout>
                                            </Grid>

                                            <VerticalStackLayout Grid.Row="1" Padding="14" Spacing="5">
                                                <Label Text="{Binding Name}" FontSize="16" FontAttributes="Bold" TextColor="#212529" LineBreakMode="TailTruncation"/>
                                                <Label Text="{Binding Address}" FontSize="12" TextColor="#6C757D" LineBreakMode="TailTruncation" MaxLines="1"/>

                                                <Grid ColumnDefinitions="*,Auto" VerticalOptions="EndAndExpand" Margin="0,4,0,0">
                                                    <VerticalStackLayout VerticalOptions="Center">
                                                        <Label Text="{Binding AvailableBeds, StringFormat='{0} beds left'}" FontSize="10" FontAttributes="Bold" TextColor="#198754"/>
                                                        <Label Text="{Binding RentText}" FontSize="15" FontAttributes="Bold" TextColor="#4A154B"/>
                                                    </VerticalStackLayout>
                                                    <Button Grid.Column="1" Text="View" WidthRequest="75" HeightRequest="36" CornerRadius="8" BackgroundColor="#4A154B" TextColor="White" FontAttributes="Bold" FontSize="12"
                                                            Command="{Binding BindingContext.GoToPGDetailCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}" 
                                                            CommandParameter="{Binding Source={RelativeSource Self}, Path=BindingContext}"/>
                                                </Grid>
                                            </VerticalStackLayout>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>

                    <VerticalStackLayout x:Name="FeaturedSection" Margin="20,24,20,0" Spacing="14">
                        <VerticalStackLayout.Triggers>
                            <DataTrigger TargetType="VerticalStackLayout" Binding="{Binding FeaturedPGs.Count}" Value="0">
                                <Setter Property="IsVisible" Value="False"/>
                            </DataTrigger>
                        </VerticalStackLayout.Triggers>

                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Featured PGs" FontSize="20" FontAttributes="Bold" TextColor="#1F1F1F"/>
                        </Grid>

                        <CollectionView ItemsSource="{Binding FeaturedPGs}" HeightRequest="310" SelectionMode="None">
                            <CollectionView.ItemsLayout>
                                <LinearItemsLayout Orientation="Horizontal" ItemSpacing="16"/>
                            </CollectionView.ItemsLayout>
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:PGCardResponse">
                                    <Border WidthRequest="260" Margin="0" BackgroundColor="White" StrokeThickness="1" Stroke="#E9ECEF">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="16"/>
                                        </Border.StrokeShape>
                                        <Border.Shadow>
                                            <Shadow Brush="#0F000000" Offset="0,6" Radius="12"/>
                                        </Border.Shadow>
                                        <Grid RowDefinitions="150,*">
                                            <Grid Grid.Row="0">
                                                <Border StrokeThickness="0">
                                                    <Border.StrokeShape>
                                                        <RoundRectangle CornerRadius="16,16,0,0"/>
                                                    </Border.StrokeShape>
                                                    <Image Source="{Binding DisplayImage, TargetNullValue='bunny_logo.png', FallbackValue='bunny_logo.png'}" Aspect="AspectFill"/>
                                                </Border>
                                                <HorizontalStackLayout Margin="12" HorizontalOptions="Start" VerticalOptions="Start" Spacing="4">
                                                    <Border Padding="8,3" BackgroundColor="#4A154B" StrokeThickness="0">
                                                        <Border.StrokeShape>
                                                            <RoundRectangle CornerRadius="6"/>
                                                        </Border.StrokeShape>
                                                        <Label Text="FEATURED" FontSize="9" FontAttributes="Bold" TextColor="White"/>
                                                    </Border>
                                                </HorizontalStackLayout>
                                            </Grid>
                                            <VerticalStackLayout Grid.Row="1" Padding="14" Spacing="6">
                                                <Label Text="{Binding Name}" FontSize="16" FontAttributes="Bold" TextColor="#212529" LineBreakMode="TailTruncation"/>
                                                <Grid ColumnDefinitions="*,Auto" VerticalOptions="EndAndExpand">
                                                    <VerticalStackLayout VerticalOptions="Center">
                                                        <Label Text="Starting From" FontSize="10" TextColor="#888"/>
                                                        <Label Text="{Binding RentText}" FontSize="16" FontAttributes="Bold" TextColor="#4A154B"/>
                                                    </VerticalStackLayout>
                                                    <Button Grid.Column="1" Text="View" WidthRequest="75" HeightRequest="36" CornerRadius="8" BackgroundColor="#4A154B" TextColor="White" FontAttributes="Bold" FontSize="12"
                                                            Command="{Binding BindingContext.GoToPGDetailCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}" 
                                                            CommandParameter="{Binding Source={RelativeSource Self}, Path=BindingContext}"/>
                                                </Grid>
                                            </VerticalStackLayout>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>

                    <VerticalStackLayout x:Name="RecommendedSection" Margin="20,24,20,0" Spacing="14"> 
                        <VerticalStackLayout.Triggers>
                            <DataTrigger TargetType="VerticalStackLayout" Binding="{Binding RecommendedPGs.Count}" Value="0">
                                <Setter Property="IsVisible" Value="False"/>
                            </DataTrigger>
                        </VerticalStackLayout.Triggers>

                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Recommended PGs" FontSize="20" FontAttributes="Bold" TextColor="#1F1F1F"/>
                        </Grid>

                        <CollectionView ItemsSource="{Binding RecommendedPGs}" HeightRequest="310" SelectionMode="None">
                            <CollectionView.ItemsLayout>
                                <LinearItemsLayout Orientation="Horizontal" ItemSpacing="16"/>
                            </CollectionView.ItemsLayout>
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:PGCardResponse">
                                    <Border WidthRequest="260" Margin="0" BackgroundColor="White" StrokeThickness="1" Stroke="#E9ECEF">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="16"/>
                                        </Border.StrokeShape>
                                        <Border.Shadow>
                                            <Shadow Brush="#0F000000" Offset="0,6" Radius="12"/>
                                        </Border.Shadow>
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewModels:PGSearchViewModel}}, Path=GoToPGDetailCommand}" CommandParameter="{Binding .}"/>
                                        </Border.GestureRecognizers>

                                        <Grid RowDefinitions="150,*">
                                            <Grid Grid.Row="0">
                                                <Border StrokeThickness="0">
                                                    <Border.StrokeShape>
                                                        <RoundRectangle CornerRadius="16,16,0,0"/>
                                                    </Border.StrokeShape>
                                                    <Image Source="{Binding DisplayImage, TargetNullValue='bunny_logo.png', FallbackValue='bunny_logo.png'}" Aspect="AspectFill"/>
                                                </Border>
                                                <HorizontalStackLayout Margin="12" HorizontalOptions="Start" VerticalOptions="Start" Spacing="4">
                                                    <Border Padding="8,3" BackgroundColor="#EAB308" StrokeThickness="0">
                                                        <Border.StrokeShape>
                                                            <RoundRectangle CornerRadius="6"/>
                                                        </Border.StrokeShape>
                                                        <Label Text="RECOMMENDED" FontSize="9" FontAttributes="Bold" TextColor="Black"/>
                                                    </Border>
                                                </HorizontalStackLayout>
                                            </Grid>

                                            <VerticalStackLayout Grid.Row="1" Padding="14" Spacing="5">
                                                <Label Text="{Binding Name}" FontSize="16" FontAttributes="Bold" TextColor="#212529" LineBreakMode="TailTruncation"/>
                                                <Label Text="{Binding Address}" FontSize="12" TextColor="#6C757D" LineBreakMode="TailTruncation" MaxLines="1"/>

                                                <Grid ColumnDefinitions="*,Auto" VerticalOptions="EndAndExpand" Margin="0,4,0,0">
                                                    <VerticalStackLayout VerticalOptions="Center">
                                                        <Label Text="Top Choice" FontSize="10" TextColor="#EAB308" FontAttributes="Bold"/>
                                                        <Label Text="{Binding RentText}" FontSize="15" FontAttributes="Bold" TextColor="#4A154B"/>
                                                    </VerticalStackLayout>
                                                    <Button Grid.Column="1" Text="View" WidthRequest="75" HeightRequest="36" CornerRadius="8" BackgroundColor="#4A154B" TextColor="White" FontAttributes="Bold" FontSize="12"
                                                            Command="{Binding BindingContext.GoToPGDetailCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}" 
                                                            CommandParameter="{Binding Source={RelativeSource Self}, Path=BindingContext}"/>
                                                </Grid>
                                            </VerticalStackLayout>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>

                    <VerticalStackLayout x:Name="RecentlyViewedSection" Margin="20,24,20,90" Spacing="14">
                        <VerticalStackLayout.Triggers>
                            <DataTrigger TargetType="VerticalStackLayout" Binding="{Binding RecentPGs.Count}" Value="0">
                                <Setter Property="IsVisible" Value="False"/>
                            </DataTrigger>
                        </VerticalStackLayout.Triggers>

                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Recently Viewed PGs" FontSize="20" FontAttributes="Bold" TextColor="#1F1F1F"/>
                        </Grid>

                        <CollectionView ItemsSource="{Binding RecentPGs}" HeightRequest="310" SelectionMode="None">
                            <CollectionView.ItemsLayout>
                                <LinearItemsLayout Orientation="Horizontal" ItemSpacing="16"/>
                            </CollectionView.ItemsLayout>
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:PGCardResponse">
                                    <Border WidthRequest="260" Margin="0" BackgroundColor="White" StrokeThickness="1" Stroke="#E9ECEF">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="16"/>
                                        </Border.StrokeShape>
                                        <Border.Shadow>
                                            <Shadow Brush="#0F000000" Offset="0,6" Radius="12"/>
                                        </Border.Shadow>
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewModels:PGSearchViewModel}}, Path=GoToPGDetailCommand}" CommandParameter="{Binding .}"/>
                                        </Border.GestureRecognizers>

                                        <Grid RowDefinitions="150,*">
                                            <Grid Grid.Row="0">
                                                <Border StrokeThickness="0">
                                                    <Border.StrokeShape>
                                                        <RoundRectangle CornerRadius="16,16,0,0"/>
                                                    </Border.StrokeShape>
                                                    <Image Source="{Binding DisplayImage, TargetNullValue='bunny_logo.png', FallbackValue='bunny_logo.png'}" Aspect="AspectFill"/>
                                                </Border>
                                                <HorizontalStackLayout Margin="12" HorizontalOptions="Start" VerticalOptions="Start" Spacing="4">
                                                    <Border BackgroundColor="#6C757D" Padding="6,2" StrokeThickness="0">
                                                        <Border.StrokeShape>
                                                            <RoundRectangle CornerRadius="4"/>
                                                        </Border.StrokeShape>
                                                        <Label Text="Viewed" FontSize="8" TextColor="White" FontAttributes="Bold"/>
                                                    </Border>
                                                </HorizontalStackLayout>
                                            </Grid>

                                            <VerticalStackLayout Grid.Row="1" Padding="14" Spacing="5">
                                                <Label Text="{Binding Name}" FontSize="16" FontAttributes="Bold" TextColor="#212529" LineBreakMode="TailTruncation"/>
                                                <Label Text="{Binding Address}" FontSize="12" TextColor="#6C757D" LineBreakMode="TailTruncation" MaxLines="1"/>

                                                <Grid ColumnDefinitions="*,Auto" VerticalOptions="EndAndExpand" Margin="0,4,0,0">
                                                    <VerticalStackLayout VerticalOptions="Center">
                                                        <Label Text="Rent" FontSize="10" TextColor="#888"/>
                                                        <Label Text="{Binding RentText}" FontSize="15" FontAttributes="Bold" TextColor="#4A154B"/>
                                                    </VerticalStackLayout>
                                                    <Button Grid.Column="1" Text="View" WidthRequest="75" HeightRequest="36" CornerRadius="8" BackgroundColor="#4A154B" TextColor="White" FontAttributes="Bold" FontSize="12"
                                                            Command="{Binding BindingContext.GoToPGDetailCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}" 
                                                            CommandParameter="{Binding Source={RelativeSource Self}, Path=BindingContext}"/>
                                                </Grid>
                                            </VerticalStackLayout>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>
    </Grid>
</ContentPage>