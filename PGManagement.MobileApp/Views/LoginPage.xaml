<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PGManagement.MobileApp.ViewModels"
             x:Class="PGManagement.MobileApp.Views.LoginPage"
             x:DataType="vm:LoginViewModel"
             ControlTemplate="{StaticResource GlobalJourneyTemplate}"
             BackgroundColor="White"
             Shell.NavBarIsVisible="False">
    <ScrollView VerticalOptions="Center">
        <VerticalStackLayout Padding="36" Spacing="22" VerticalOptions="Center">

            <VerticalStackLayout Spacing="6" HorizontalOptions="Center" Margin="0,0,0,16">
                <Label Text="BUNNY PG" FontSize="26" FontAttributes="Bold" TextColor="#4A154B" HorizontalOptions="Center" CharacterSpacing="1.5" />
                <Label Text="Enterprise Portal System" FontSize="13" TextColor="#8D96A0" HorizontalOptions="Center" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="14">
                <Border Padding="12,2" StrokeShape="RoundRectangle 12" StrokeThickness="1" Stroke="#E2E8F0" BackgroundColor="#F8F9FA">
                    <Entry Placeholder="Account Email" Keyboard="Email" Text="{Binding Email}" TextColor="#4A154B" PlaceholderColor="#A0AEC0" HeightRequest="46"/>
                </Border>

                <Border Padding="12,2" StrokeShape="RoundRectangle 12" StrokeThickness="1" Stroke="#E2E8F0" BackgroundColor="#F8F9FA">
                    <Entry Placeholder="Security Password" IsPassword="True" Text="{Binding Password}" TextColor="#4A154B" PlaceholderColor="#A0AEC0" HeightRequest="46"/>
                </Border>
            </VerticalStackLayout>

            <Label Text="{Binding ErrorMessage}" TextColor="#E74C3C" FontSize="13" HorizontalTextAlignment="Center"
                   IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyConverter}}" />

            <VerticalStackLayout Spacing="14" Margin="0,10,0,0">
                <Button Text="Authenticate Access" Command="{Binding LoginCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
                        BackgroundColor="#4A154B" TextColor="White" HeightRequest="52" CornerRadius="12" FontAttributes="Bold" FontSize="16" />

                <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="#4A154B" HorizontalOptions="Center"/>

                <Button Text="Establish New Enterprise Account" Command="{Binding GoToRegisterCommand}"
                        BackgroundColor="Transparent" TextColor="#4A154B" FontAttributes="Bold" FontSize="14" HeightRequest="44"/>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>