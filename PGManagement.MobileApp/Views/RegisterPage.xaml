<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PGManagement.MobileApp.ViewModels"
             x:Class="PGManagement.MobileApp.Views.RegisterPage"
             x:DataType="vm:RegisterViewModel"
             Title="Account Provisioning"
             BackgroundColor="White">

    <ScrollView>
        <VerticalStackLayout Padding="36" Spacing="20" VerticalOptions="Center">

            <VerticalStackLayout Spacing="4" HorizontalOptions="Center" Margin="0,10,0,10">
                <Label Text="Onboarding System" FontSize="24" FontAttributes="Bold" TextColor="#1A1A1A" HorizontalOptions="Center" />
                <Label Text="Create your administrative profile" FontSize="13" TextColor="#8D96A0" HorizontalOptions="Center" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="14">
                <Border Padding="12,2" StrokeShape="RoundRectangle 12" StrokeThickness="1" Stroke="#E2E8F0" BackgroundColor="#F8F9FA">
                    <Entry Placeholder="Full Identity Legal Name" Text="{Binding FullName}" PlaceholderColor="#A0AEC0" HeightRequest="46"/>
                </Border>

                <Border Padding="12,2" StrokeShape="RoundRectangle 12" StrokeThickness="1" Stroke="#E2E8F0" BackgroundColor="#F8F9FA">
                    <Entry Placeholder="Corporate Email Address" Keyboard="Email" Text="{Binding Email}" PlaceholderColor="#A0AEC0" HeightRequest="46"/>
                </Border>

                <Border Padding="12,2" StrokeShape="RoundRectangle 12" StrokeThickness="1" Stroke="#E2E8F0" BackgroundColor="#F8F9FA">
                    <Entry Placeholder="Define Security Password" IsPassword="True" Text="{Binding Password}" PlaceholderColor="#A0AEC0" HeightRequest="46"/>
                </Border>

                <!-- Modern Segmented Picker Treatment -->
                <VerticalStackLayout Spacing="6" Margin="2,4,0,0">
                    <Label Text="Account Profile Classification:" FontAttributes="Bold" FontSize="12" TextColor="#6C757D" CharacterSpacing="0.5"/>
                    <Border Padding="12,2" StrokeShape="RoundRectangle 12" StrokeThickness="1" Stroke="#E2E8F0" BackgroundColor="#F8F9FA">
                        <Picker ItemsSource="{Binding Roles}" SelectedItem="{Binding SelectedRole}" Title="Choose profile system role..." TitleColor="#A0AEC0" HeightRequest="46" />
                    </Border>
                </VerticalStackLayout>
            </VerticalStackLayout>

            <Label Text="{Binding ErrorMessage}" TextColor="#E74C3C" FontSize="13" HorizontalTextAlignment="Center"
                   IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyConverter}}" />

            <VerticalStackLayout Spacing="12" Margin="0,16,0,0">
                <Button Text="Complete Profile Registration" Command="{Binding RegisterCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
                        BackgroundColor="#4A154B" TextColor="White" HeightRequest="52" CornerRadius="12" FontAttributes="Bold" FontSize="16"/>

                <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="#512BD4" HorizontalOptions="Center"/>

                <Button Text="Return to Terminal Authentication" Command="{Binding GoToLoginCommand}"
                        BackgroundColor="Transparent" TextColor="#6C757D" FontSize="14" HeightRequest="44"/>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>