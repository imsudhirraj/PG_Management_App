<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PGManagement.MobileApp.ViewModels"
             x:Class="PGManagement.MobileApp.Views.ProfilePage"
             x:DataType="vm:ProfileViewModel"
             ControlTemplate="{StaticResource GlobalJourneyTemplate}"
             Title="My Profile"
             BackgroundColor="{AppThemeBinding Light=#F8F9FA, Dark=#121212}">

    <ScrollView>
        <!-- Bottom padding ensures navigation elements remain accessible -->
        <VerticalStackLayout Padding="20,16,20,90" Spacing="16" VerticalOptions="Start">

            <!-- Hero Profile Card Header -->
            <Border Padding="20" StrokeThickness="0" BackgroundColor="#4A154B">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16"/>
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Offset="0,4" Radius="10" Brush="#000000" Opacity="0.15"/>
                </Border.Shadow>

                <VerticalStackLayout Spacing="6" HorizontalOptions="Center">

                    <!-- Avatar circle placeholder using name initial -->
                    <Border HeightRequest="64" WidthRequest="64" BackgroundColor="#350E36" StrokeThickness="0" HorizontalOptions="Center" Margin="0,0,0,4">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="32"/>
                        </Border.StrokeShape>
                        <Label Text="👤" FontSize="28" HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Border>

                    <Label Text="{Binding FullName}" FontSize="22" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center" />

                    <Border BackgroundColor="#350E36" Padding="12,4" StrokeThickness="0" HorizontalOptions="Center">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8"/>
                        </Border.StrokeShape>
                        <Label Text="{Binding Role}" FontSize="11" FontAttributes="Bold" TextColor="#E2A4E4" CharacterSpacing="0.5" TextTransform="Uppercase" />
                    </Border>

                    <Label Text="{Binding Email}" FontSize="13" TextColor="#D6C1D7" HorizontalOptions="Center" Margin="0,2,0,0"/>
                </VerticalStackLayout>
            </Border>

            <Label Text="Account Settings" FontSize="12" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" CharacterSpacing="0.5" Margin="4,8,0,0" />

            <!-- Clean Option Navigation Row (Replaces heavy colored button container) -->
            <Border StrokeThickness="0" BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12"/>
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Offset="0,2" Radius="6" Brush="#000000" Opacity="0.05"/>
                </Border.Shadow>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding GoToSettingsCommand}" />
                </Border.GestureRecognizers>

                <Grid ColumnDefinitions="Auto, *, Auto" Padding="16,14" ColumnSpacing="12" BackgroundColor="#F6EEF5">
                    <!-- Modern Vector Gear Icon -->
                    <Path Grid.Column="0" 
                          Data="M19.43 12.98c.04-.32.07-.64.07-.98s-.03-.66-.07-.98l2.11-1.65c.19-.15.24-.42.12-.64l-2-3.46c-.12-.22-.39-.3-.61-.22l-2.49 1c-.52-.4-1.08-.73-1.69-.98l-.38-2.65C14.46 2.18 14.25 2 14 2h-4c-.25 0-.46.18-.49.42l-.38 2.65c-.61.25-1.17.59-1.69.98l-2.49-1c-.23-.09-.49 0-.61.22l-2 3.46c-.13.22-.07.49.12.64l2.11 1.65c-.04.32-.07.65-.07.98s.03.66.07.98l-2.11 1.65c-.19.15-.24.42-.12.64l2 3.46c.12.22.39.3.61.22l2.49-1c.52.4 1.08.73 1.69.98l.38 2.65c.03.24.24.42.49.42h4c.25 0 .46-.18.49-.42l-.38-2.65c.61-.25 1.17-.59 1.69-.98l2.49 1c.23.09.49 0 .61-.22l2-3.46c.12-.22.07-.49-.12-.64l-2.11-1.65zM12 15.5c-1.93 0-3-1.57-3-3.5s1.07-3.5 3-3.5 3 1.57 3 3.5-1.07 3.5-3 3.5z" 
                          Fill="#4A154B" VerticalOptions="Center" HeightRequest="18" WidthRequest="18"/>

                    <Label Grid.Column="1" Text="Core Application Settings" FontSize="14" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#1E293B, Dark=White}" VerticalOptions="Center"/>

                    <!-- Chevron Arrow pointer indicator -->
                    <Path Grid.Column="2" Data="M8.59 16.58L13.17 12 8.59 7.41 10 6l6 6-6 6-1.41-1.42z" 
                          Fill="{AppThemeBinding Light=#94A3B8, Dark=#64748B}" VerticalOptions="Center" HeightRequest="16" WidthRequest="16"/>
                </Grid>
            </Border>

            <!-- Secondary/Muted Sign-out Action link button layout -->
            <Button Text="Log Out" 
                    Command="{Binding LogoutCommand}" 
                    BackgroundColor="#F6EEF5" 
                    TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" 
                    BorderColor="{AppThemeBinding Light=#CBD5E1, Dark=#333333}"
                    BorderWidth="1"
                    HeightRequest="44" 
                    CornerRadius="8" 
                    FontAttributes="Bold" 
                    FontSize="14" 
                    Margin="0,24,0,0"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>