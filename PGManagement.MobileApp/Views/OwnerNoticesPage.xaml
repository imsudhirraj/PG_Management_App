<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PGManagement.MobileApp.ViewModels"
             xmlns:models="clr-namespace:PGManagement.MobileApp.Models"
             x:Class="PGManagement.MobileApp.Views.OwnerNoticesPage"
             x:DataType="vm:OwnerNoticesViewModel"
             Title="Communications Bulletin"
             BackgroundColor="#F8F9FA">

    <RefreshView Command="{Binding LoadCommand}" IsRefreshing="{Binding IsBusy}" RefreshColor="#512BD4">
        <ScrollView>
            <VerticalStackLayout Padding="20" Spacing="20">

                <Border Padding="16" StrokeShape="RoundRectangle 16" StrokeThickness="0" BackgroundColor="White">
                    <Border.Shadow>
                        <Shadow Offset="0,4" Radius="12" Brush="#0A000000" Opacity="0.5"/>
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="12">
                        <Label Text="Dispatch Operational Bulletin" FontAttributes="Bold" FontSize="14" TextColor="#4A154B" />

                        <VerticalStackLayout Spacing="4">
                            <Label Text="Select Target Property Channel" FontSize="11" FontAttributes="Bold" TextColor="#6C757D" />
                            <Border Padding="10,2" StrokeShape="RoundRectangle 10" StrokeThickness="1" Stroke="#E2E8F0" BackgroundColor="#F8F9FA">
                                <Picker ItemsSource="{Binding MyPGs}" ItemDisplayBinding="{Binding Name}" SelectedItem="{Binding SelectedPG}" HeightRequest="42"/>
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="4">
                            <Label Text="Broadcast Heading Statement" FontSize="11" FontAttributes="Bold" TextColor="#6C757D" />
                            <Border Padding="12,2" StrokeShape="RoundRectangle 10" StrokeThickness="1" Stroke="#E2E8F0" BackgroundColor="#F8F9FA">
                                <Entry Placeholder="Urgent: Maintenance Window, Event announcement..." Text="{Binding NewTitle}" PlaceholderColor="#A0AEC0" HeightRequest="42"/>
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="4">
                            <Label Text="Payload Information Context" FontSize="11" FontAttributes="Bold" TextColor="#6C757D" />
                            <Border Padding="12,4" StrokeShape="RoundRectangle 10" StrokeThickness="1" Stroke="#E2E8F0" BackgroundColor="#F8F9FA">
                                <Editor Placeholder="Detailed dispatch announcement payload text goes here..." Text="{Binding NewMessage}" PlaceholderColor="#A0AEC0" HeightRequest="75"/>
                            </Border>
                        </VerticalStackLayout>

                        <Button Text="Broadcast Notification" Command="{Binding PostNoticeCommand}" BackgroundColor="#512BD4" TextColor="White" HeightRequest="44" CornerRadius="10" FontAttributes="Bold" FontSize="14" Margin="0,4,0,0"/>
                    </VerticalStackLayout>
                </Border>

                <BoxView HeightRequest="1" Color="#EDF2F7" />

                <Label Text="Historical Dispatch Stream" FontAttributes="Bold" FontSize="14" TextColor="#1A1A1A" Margin="2,0" />
                <Label Text="{Binding StatusMessage}" IsVisible="{Binding StatusMessage, Converter={StaticResource StringNotEmptyConverter}}" TextColor="#A0AEC0" FontAttributes="Italic" HorizontalTextAlignment="Center"/>

                <CollectionView ItemsSource="{Binding Notices}" HeightRequest="380">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:NoticeOverviewResponse">
                            <Border Margin="0,0,0,12" Padding="14" StrokeShape="RoundRectangle 14" StrokeThickness="0" BackgroundColor="White">
                                <Border.Shadow>
                                    <Shadow Offset="0,2" Radius="6" Brush="#0A000000" Opacity="0.4"/>
                                </Border.Shadow>
                                <VerticalStackLayout Spacing="6">
                                    <Label Text="{Binding Title}" FontAttributes="Bold" FontSize="15" TextColor="#1A1A1A" />

                                    <HorizontalStackLayout Spacing="6">
                                        <Border BackgroundColor="#F0EDFA" Padding="6,3" StrokeShape="RoundRectangle 4" StrokeThickness="0">
                                            <Label Text="{Binding PGName}" FontSize="10" FontAttributes="Bold" TextColor="#512BD4" />
                                        </Border>
                                        <Label Text="{Binding CreatedAt, StringFormat='Dispatched: {0:dd MMM yyyy}'}" FontSize="11" TextColor="#A0AEC0" VerticalOptions="Center"/>
                                    </HorizontalStackLayout>

                                    <Label Text="{Binding Message}" FontSize="13" TextColor="#4A5568" LineHeight="1.2" Margin="0,4,0,0"/>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</ContentPage>