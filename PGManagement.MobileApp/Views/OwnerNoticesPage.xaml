<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PGManagement.MobileApp.ViewModels"
             xmlns:models="clr-namespace:PGManagement.MobileApp.Models"
             x:Class="PGManagement.MobileApp.Views.OwnerNoticesPage"
             x:DataType="vm:OwnerNoticesViewModel"
             Title="Notices">

    <RefreshView Command="{Binding LoadCommand}" IsRefreshing="{Binding IsBusy}">
        <ScrollView>
            <VerticalStackLayout Padding="16" Spacing="10">

                <Label Text="Post a New Notice" FontAttributes="Bold" />
                <Picker ItemsSource="{Binding MyPGs}" ItemDisplayBinding="{Binding Name}" SelectedItem="{Binding SelectedPG}" />
                <Entry Placeholder="Title" Text="{Binding NewTitle}" />
                <Editor Placeholder="Message" Text="{Binding NewMessage}" HeightRequest="70" />
                <Button Text="Post Notice" Command="{Binding PostNoticeCommand}" />

                <BoxView HeightRequest="1" Color="LightGray" Margin="0,10" />

                <Label Text="{Binding StatusMessage}" IsVisible="{Binding StatusMessage, Converter={StaticResource StringNotEmptyConverter}}" />

                <CollectionView ItemsSource="{Binding Notices}" HeightRequest="400">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:NoticeOverviewResponse">
                            <Border Margin="0,0,0,10" Padding="12" StrokeShape="RoundRectangle 10" Stroke="LightGray">
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="{Binding Title}" FontAttributes="Bold" />
                                    <Label Text="{Binding PGName}" FontSize="11" TextColor="Gray" />
                                    <Label Text="{Binding Message}" FontSize="13" />
                                    <Label Text="{Binding CreatedAt, StringFormat='{0:dd MMM yyyy}'}" FontSize="11" TextColor="Gray" />
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</ContentPage>