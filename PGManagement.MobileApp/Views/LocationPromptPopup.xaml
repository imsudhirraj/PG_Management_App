<?xml version="1.0" encoding="utf-8" ?>
<mct:Popup 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:mct="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    x:Class="PGManagement.MobileApp.Views.LocationPromptPopup"
    Color="Transparent">

    <!-- Premium Animated Bottom Sheet Card Background -->
    <Border 
        WidthRequest="340" 
        Padding="24" 
        BackgroundColor="White" 
        StrokeThickness="0">
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="24"/>
        </Border.StrokeShape>
        <Border.Shadow>
            <Shadow Brush="#30000000" Offset="0,15" Radius="30"/>
        </Border.Shadow>

        <VerticalStackLayout Spacing="20" HorizontalOptions="Fill">

            <!-- Animated Pulse Core Vector Graphic Element -->
            <Grid HeightRequest="80" WidthRequest="80" HorizontalOptions="Center">
                <Border BackgroundColor="#F5EEF6" HeightRequest="80" WidthRequest="80" StrokeThickness="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="40"/>
                    </Border.StrokeShape>
                </Border>

                <Border BackgroundColor="#EAD3EA" HeightRequest="60" WidthRequest="60" StrokeThickness="0" HorizontalOptions="Center" VerticalOptions="Center">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="30"/>
                    </Border.StrokeShape>
                </Border>

                <!-- High Fidelity Clean GPS Path Vector -->
                <Path Data="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z M12 13a3 3 0 1 0 0-6 3 3 0 0 0 0 6z" 
                      Stroke="#4A154B" 
                      StrokeThickness="2.5" 
                      StrokeLineCap="Round" 
                      StrokeLineJoin="Round" 
                      Aspect="Uniform"
                      HeightRequest="28" 
                      WidthRequest="28" 
                      HorizontalOptions="Center" 
                      VerticalOptions="Center"/>
            </Grid>

            <!-- Text Content Stack -->
            <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                <Label Text="Enable Location Services" 
                       FontSize="20" 
                       FontAttributes="Bold" 
                       TextColor="#2D0B30" 
                       HorizontalTextAlignment="Center"/>
                <Label Text="To display verified premium PGs nearby, Bunny PG requires access to your device's live hardware location switch." 
                       FontSize="13" 
                       TextColor="#6C757D" 
                       LineHeight="1.3"
                       HorizontalTextAlignment="Center"/>
            </VerticalStackLayout>

            <!-- Elegant Multi-Tone Action Buttons Matrix -->
            <VerticalStackLayout Spacing="10">
                <Button Text="Grant Hardware Access" 
                        HeightRequest="48"
                        CornerRadius="12"
                        FontAttributes="Bold"
                        FontSize="14"
                        BackgroundColor="#4A154B" 
                        TextColor="White"
                        Clicked="OnAllowClicked"/>

                <Button Text="Explore Manually" 
                        HeightRequest="44"
                        CornerRadius="12"
                        FontAttributes="Bold"
                        FontSize="13"
                        BackgroundColor="Transparent" 
                        TextColor="#A3849E"
                        Clicked="OnCancelClicked"/>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </Border>
</mct:Popup>