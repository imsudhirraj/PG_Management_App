<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PGManagement.MobileApp.ViewModels"
             xmlns:models="clr-namespace:PGManagement.MobileApp.Models"
             x:Class="PGManagement.MobileApp.Views.WishlistPage"
             x:DataType="vm:WishlistViewModel"
             Title="Saved Wishlist"
             BackgroundColor="{AppThemeBinding Light=#F8F9FA, Dark=#121212}"
             ControlTemplate="{StaticResource GlobalJourneyTemplate}">

    <Grid Padding="20,15,20,90" RowDefinitions="Auto, *" RowSpacing="15">

        <!-- Page Header -->
        <VerticalStackLayout Grid.Row="0" Spacing="4">
            <Label Text="Your Wishlist" FontSize="28" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#4A154B, Dark=#E2A4E4}" />
            <Label Text="Shortlisted stays and properties you like" FontSize="20" TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" />
        </VerticalStackLayout>

        <!-- Content Area -->
        <Grid Grid.Row="1" Margin="0,15,0,0">

            <!-- STATE A: Empty View (Evaluates item collection footprint) -->
            <VerticalStackLayout IsVisible="{Binding WishlistItems.Count, Converter={StaticResource EmptyCollectionToVisibleConverter}}" VerticalOptions="Center" HorizontalOptions="Center" Spacing="15">
                <Border WidthRequest="80" HeightRequest="80" BackgroundColor="#F5EEF6" StrokeThickness="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="40"/>
                    </Border.StrokeShape>
                    <Path Data="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z" 
                          Fill="#631D64" HorizontalOptions="Center" VerticalOptions="Center" HeightRequest="32" WidthRequest="32"/>
                </Border>
                <Label Text="No saved properties yet" FontAttributes="Bold" FontSize="18" HorizontalTextAlignment="Center" TextColor="{AppThemeBinding Light=#1E293B, Dark=White}" />
                <Label Text="{Binding EmptyStateMessage}" FontSize="14" HorizontalTextAlignment="Center" TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" />

                <!-- Actionable Login Route if User is Unauthenticated -->
                <!--<Button Text="Login to Sync" 
                        Command="{Binding RedirectToLoginAsyncCommand}" 
                        IsVisible="{Binding IsUserAnonymous}"
                        BackgroundColor="#4A154B" TextColor="White" CornerRadius="8" Margin="0,10,0,0"/>-->
            </VerticalStackLayout>

            <!-- STATE B: Live Shortlisted Properties -->
            <CollectionView ItemsSource="{Binding WishlistItems}">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="10"/>
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:PGCardResponse">
                        <Border Padding="16,14" 
                    StrokeThickness="0" 
                    BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12"/>
                            </Border.StrokeShape>
                            <Border.Shadow>
                                <Shadow Brush="#000000" Offset="0,2" Radius="4" Opacity="0.06"/>
                            </Border.Shadow>

                            <Border.GestureRecognizers>
                                <TapGestureRecognizer 
                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:WishlistViewModel}}, Path=SelectWishlistItemCommand}"
                        CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>

                            <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">

                                <VerticalStackLayout Grid.Column="0" Spacing="3" VerticalOptions="Center">
                                    <Label Text="{Binding Name}" 
                               FontAttributes="Bold" 
                               FontSize="16"
                               TextColor="{AppThemeBinding Light=#1E293B, Dark=White}"/>
                                    <Label Text="{Binding City}" 
                               FontSize="13" 
                               TextColor="#64748B"/>
                                    <Label Text="{Binding StartingRent, StringFormat='₹{0:N0}/mo'}" 
                               FontAttributes="Bold" 
                               FontSize="14"
                               TextColor="#4A154B"
                               Margin="0,2,0,0"/>
                                </VerticalStackLayout>

                                <Label Grid.Column="1"
                           Text="&#x2665;" 
                           FontSize="26"
                           TextColor="#4A154B" 
                           HorizontalOptions="End" 
                           VerticalOptions="Center"
                           HorizontalTextAlignment="Center"
                           VerticalTextAlignment="Center"
                           WidthRequest="44"
                           HeightRequest="44">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer 
                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:WishlistViewModel}}, Path=RemoveFromWishlistCommand}" 
                                CommandParameter="{Binding .}" />
                                    </Label.GestureRecognizers>
                                </Label>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>
    </Grid>
</ContentPage>