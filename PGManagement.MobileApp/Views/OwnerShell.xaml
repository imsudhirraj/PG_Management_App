<?xml version="1.0" encoding="utf-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:views="clr-namespace:PGManagement.MobileApp.Views"
       x:Class="PGManagement.MobileApp.Views.OwnerShell"
       FlyoutBehavior="Disabled">

    <TabBar>
        <ShellContent Title="Dashboard" Icon="dashboard.png"
                      ContentTemplate="{DataTemplate views:HomePage}" Route="DashboardPage" />
        <ShellContent Title="My PGs" Icon="building.png"
                      ContentTemplate="{DataTemplate views:HomePage}" Route="MyPGsPage" />
        <ShellContent Title="Profile" Icon="profile.png"
                      ContentTemplate="{DataTemplate views:HomePage}" Route="OwnerProfilePage" />
    </TabBar>

</Shell>