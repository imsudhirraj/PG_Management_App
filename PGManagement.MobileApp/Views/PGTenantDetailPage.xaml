<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PGManagement.MobileApp.ViewModels;assembly=PGManagement.MobileApp"
             xmlns:models="clr-namespace:PGManagement.MobileApp.Models;assembly=PGManagement.MobileApp"
             x:Class="PGManagement.MobileApp.Views.PGTenantDetailPage"
             x:DataType="vm:PGTenantDetailViewModel"
             ControlTemplate="{StaticResource GlobalJourneyTemplate}"
             Title="PG Details"
             BackgroundColor="#F5EEF6"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto, *" Padding="20,24,20,90" RowSpacing="16">

        <VerticalStackLayout Grid.Row="0" Spacing="8" Margin="0,12,0,0">
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="#4A154B" />

            <Grid ColumnDefinitions="*, Auto" ColumnSpacing="12" VerticalOptions="Center">
                <Label Grid.Column="0" 
                       Text="{Binding Name}" 
                       FontSize="26" 
                       FontAttributes="Bold" 
                       TextColor="#2D0B30" 
                       LineBreakMode="TailTruncation"
                       MaxLines="2"
                       VerticalOptions="Center"/>

                <Border Grid.Column="1" WidthRequest="44" HeightRequest="44" StrokeThickness="0" BackgroundColor="White" VerticalOptions="Center">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="22"/>
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="#0F000000" Offset="0,2" Radius="6"/>
                    </Border.Shadow>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ToggleWishlistCommand}" />
                    </Border.GestureRecognizers>
                    <Label HorizontalOptions="Center"
                           VerticalOptions="Center"
                           HorizontalTextAlignment="Center"
                           VerticalTextAlignment="Center"
                           Text="{Binding IsWishlisted, Converter={StaticResource WishlistGlyphConverter}, FallbackValue='&#x2661;'}"
                           FontSize="18"
                           TextColor="{Binding IsWishlisted, Converter={StaticResource WishlistColorConverter}, FallbackValue='#4A154B'}"
                           Margin="0,0,0,1"/>
                </Border>
            </Grid>

            <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                <Path Data="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z M12 13a3 3 0 1 0 0-6 3 3 0 0 0 0 6z" 
                      Stroke="#631D64" StrokeThickness="1.5" HeightRequest="14" WidthRequest="14" VerticalOptions="Center"/>
                <Label FontSize="13" TextColor="#631D64" VerticalOptions="Center">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="{Binding Address}" />
                            <Span Text=", " />
                            <Span Text="{Binding City}" FontAttributes="Bold" />
                        </FormattedString>
                    </Label.FormattedText>
                </Label>
            </HorizontalStackLayout>

            <Label Text="{Binding Description}" FontSize="13" TextColor="#495057" Margin="0,4,0,0" LineHeight="1.3" />

            <BoxView HeightRequest="1" BackgroundColor="#E2CCD3" Margin="0,10,0,4" />

            <Label Text="Available Rooms" FontAttributes="Bold" FontSize="18" TextColor="#1F1F1F" />

            <Label Text="{Binding StatusMessage}" TextColor="#EF4444" FontSize="12" FontAttributes="Italic"
                   IsVisible="{Binding StatusMessage, Converter={StaticResource StringNotEmptyConverter}}" />
        </VerticalStackLayout>

        <CollectionView Grid.Row="1" ItemsSource="{Binding Rooms}">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="14"/>
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:RoomResponse">
                    <Border Padding="16" BackgroundColor="White" StrokeThickness="1" Stroke="#E9ECEF">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16"/>
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="#0F000000" Offset="0,4" Radius="10"/>
                        </Border.Shadow>

                        <Grid RowDefinitions="Auto, Auto" ColumnDefinitions="*, Auto" RowSpacing="12">
                            <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="3">
                                <Label Text="{Binding RoomNumber, StringFormat='Room {0}'}" FontAttributes="Bold" FontSize="16" TextColor="#212529"/>
                                <Label Text="{Binding RoomType}" FontSize="12" TextColor="#6C757D"/>

                                <Grid ColumnDefinitions="Auto, Auto" ColumnSpacing="8" Margin="0,2,0,0">
                                    <Label Grid.Column="0" Text="{Binding RentAmount, StringFormat='₹{0:N0}/mo'}" FontAttributes="Bold" FontSize="15" TextColor="#4A154B" VerticalOptions="Center"/>
                                    <Label Grid.Column="1" Text="{Binding AvailableBeds, StringFormat='• {0} left'}" FontSize="12" FontAttributes="Bold" TextColor="#198754" VerticalOptions="Center"/>
                                </Grid>
                            </VerticalStackLayout>

                            <Button Grid.Row="0"
                                    Grid.Column="1"
                                    Text="Book"
                                    FontAttributes="Bold"
                                    WidthRequest="80"
                                    HeightRequest="38"
                                    CornerRadius="8"
                                    Padding="0"
                                    FontSize="13"
                                    BackgroundColor="#4A154B"
                                    TextColor="White"
                                    VerticalOptions="Center"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:PGTenantDetailViewModel}}, Path=BookRoomCommand}"
                                    CommandParameter="{Binding .}" />

                            <Border Grid.Row="1" Grid.ColumnSpan="2" Stroke="#E2CCD3" StrokeThickness="1" Padding="12,2" BackgroundColor="#F5EEF6" HeightRequest="44">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="8"/>
                                </Border.StrokeShape>
                                <Entry Placeholder="Message to Owner (optional)"
                                       PlaceholderColor="#A3849E"
                                       FontSize="13"
                                       TextColor="#2D0B30"
                                       BackgroundColor="Transparent"
                                       Text="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.BookingMessage}" />
                            </Border>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>