<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PGManagement.MobileApp.ViewModels"
             xmlns:models="clr-namespace:PGManagement.MobileApp.Models"
             x:Class="PGManagement.MobileApp.Views.PGTenantDetailPage"
             x:DataType="vm:PGTenantDetailViewModel"
             Title="PG Details">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="10">

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />

            <Label Text="{Binding Name}" FontSize="22" FontAttributes="Bold" />
            <Label Text="{Binding Address}" FontSize="13" TextColor="Gray" />
            <Label Text="{Binding City}" FontSize="13" TextColor="Gray" />
            <Label Text="{Binding Description}" FontSize="13" Margin="0,6,0,0" />

            <BoxView HeightRequest="1" Color="LightGray" Margin="0,12,0,6" />
            <Label Text="Available Rooms" FontAttributes="Bold" FontSize="16" />

            <Label Text="{Binding StatusMessage}" TextColor="Red"
                   IsVisible="{Binding StatusMessage, Converter={StaticResource StringNotEmptyConverter}}" />

            <CollectionView ItemsSource="{Binding Rooms}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:RoomResponse">
                        <Border Margin="0,0,0,10" Padding="14" StrokeShape="RoundRectangle 12" Stroke="LightGray">
                            <Grid RowDefinitions="Auto,Auto"
      ColumnDefinitions="*,Auto">

                                <!-- Room Information -->
                                <VerticalStackLayout Grid.Row="0"
                         Grid.Column="0"
                         Spacing="4">

                                    <Label Text="{Binding RoomNumber,
                              StringFormat='Room {0}'}"
               FontAttributes="Bold"
               FontSize="18"/>

                                    <Label Text="{Binding RoomType}"
               FontSize="13"
               TextColor="Gray"/>

                                    <Label Text="{Binding RentAmount,
                              StringFormat='₹{0:N0}/month'}"
               FontSize="15"/>

                                    <Label Text="{Binding AvailableBeds,
                              StringFormat='{0} bed(s) available'}"
               TextColor="Green"/>
                                </VerticalStackLayout>

                                <!-- Book Button -->
                                <Button Grid.Row="0"
            Grid.Column="1"
            Text="Book"
            WidthRequest="70"
            HeightRequest="45"
            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:PGTenantDetailViewModel}},
                              Path=BookRoomCommand}"
            CommandParameter="{Binding .}" />

                                <!-- Message -->
                                <Entry Grid.Row="1"
           Grid.ColumnSpan="2"
           Margin="0,10,0,0"
           Placeholder="Message to Owner (optional)"
           Text="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}},
                          Path=BindingContext.BookingMessage}" />

                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>